# Gemini API Configuration (OpenClaw Super Agent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend & Ports
PORT=8090
VITE_API_BASE_URL=/api
NODE_ENV=production

# Supabase Cloud Database (Opcional para persistencia global)
SUPABASE_URL=
SUPABASE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Seguridad (obligatorio)
# Contraseña para entrar al dashboard
DASHBOARD_PASSWORD=
# Token para agentes y scripts: cabecera Authorization: Bearer <API_TOKEN>
API_TOKEN=
# Orígenes externos con permiso CORS, separados por coma (vacío = solo el propio dominio)
ALLOWED_ORIGINS=
