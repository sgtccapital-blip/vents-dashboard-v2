# Gemini (OpenClaw). Sin clave el agente funciona con el motor local (consultas, tareas, eventos, notas y RAG).
# La clave también se puede guardar desde el dashboard; la del entorno tiene prioridad.
GEMINI_API_KEY=
# Modelo preferido; si falla, el servidor prueba gemini-2.5-flash y gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash

# Backend & Ports
PORT=8090
VITE_API_BASE_URL=/api
NODE_ENV=production

# Supabase Cloud Database (Opcional para persistencia global)
SUPABASE_URL=
SUPABASE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Seguridad (obligatorio)
# Contraseña para entrar al dashboard
DASHBOARD_PASSWORD=
# Token para agentes y scripts: cabecera Authorization: Bearer <API_TOKEN>
API_TOKEN=
# Orígenes externos con permiso CORS, separados por coma (vacío = solo el propio dominio)
ALLOWED_ORIGINS=
